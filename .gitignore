# Python
__pycache__/
*.py[oc]
build/
# dist/: the plugin zip (with the engine inside) is tracked, so it can be downloaded from GitHub and
# installed on any laptop (tests/test_dist.py fails when it is stale). The light zip, the .mcpb and
# the builders' .tmp files stay out.
dist/*
!dist/dj-librarian-plugin-*.zip
dist/dj-librarian-plugin-*-no-engine.zip
wheels/
*.egg-info
.venv/
.pytest_cache/
.ruff_cache/
.coverage

# Secrets — never commit
.env
.env.*
!.env.example
.cache/

# User library state — lives in each user's dj-library/ folder, never in the repo.
# Anchored to the repo root: docs/prompts/plans/ and similar folders deeper down are tracked.
# (the default dj-library/ folder inside the repo is ignored as a whole: exports hold personal paths)
dj-library/
/backups/
/inbox/
/plans/
/proposals/
/reports/
/state/
/wishlist/
/tracklists/
*.db
*.db-wal
*.db-shm

# Maintainer's own files (kept in place for daily use, never tracked)
STATE.md
log.md
CRATES.md
links.yaml
tidy.yaml
bases.yaml
tree.yaml
dj-console.ps1
Claude outputs/
local/
*.local.*

# Claude Code local settings
.claude/settings.local.json

# Plugin caches. plugin/engine/ is the engine copy scripts/build_plugin_zip.py puts in the zip only
# (D-29); vendor/ and engine.mcpb are older layouts (D-22, W-34) a local build may have left.
.mcpb-cache/
/plugin/engine/
/plugin/vendor/
/plugin/engine.mcpb
# Rendered locally, not tracked (W-35): the handout previews and the R-409 copy of the Booth shot
/docs/handout/preview-*.png
/docs/samples/report.png

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
