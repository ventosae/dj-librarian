.coverage

# Secrets — never commit
.env
.env.*
!.env.example
.cache/

# User library state — lives in each user's dj-library/ folder, never in the repo.
# Anchored to the repo root: docs/prompts/plans/ and similar folders deeper down are tracked.
# (the default dj-library/ folder inside the repo is ignored as a whole: exports hold personal paths)
dj-library/
/backups/
/inbox/
/plans/
/proposals/
/reports/
/state/
/wishlist/
/tracklists/
*.db
*.db-wal
*.db-shm

# Maintainer's own files (kept in place for daily use, never tracked)
STATE.md
log.md
CRATES.md
links.yaml
tidy.yaml
bases.yaml
tree.yaml
dj-console.ps1
Claude outputs/
local/
*.local.*

# Claude Code local settings
.claude/settings.local.json

# Plugin caches, and the core scripts/build_plugin_zip.py vendors into the zip only (D-22).
# plugin/engine.mcpb is the engine bundle scripts/build_mcpb.py --plugin writes (W-34); Claude
# Code extracts a plugin's bundle into .mcpb-cache/.
.mcpb-cache/
/plugin/vendor/
/plugin/engine.mcpb

# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
