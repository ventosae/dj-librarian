{
  "description": "Write gate (R-1105, C-10): a dj-librarian write tool called without the preview_id of its preview is denied.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_dj-librarian_dj-librarian|dj-librarian)__[A-Za-z0-9_]+_(apply|write|undo)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "--python", ">=3.9", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/gate.py"],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
